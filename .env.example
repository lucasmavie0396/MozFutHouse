# MozFutHouse — variáveis de ambiente
# Copie este ficheiro para ".env" e preencha os valores necessários.
# O servidor carrega .env automaticamente no arranque.
# Variáveis já definidas no sistema (process.env) NÃO são sobrescritas.

# ── Servidor ──────────────────────────────────────────────────────────
# Porta HTTP/WebSocket (por omissão 3000)
#PORT=3000

# ── Base de dados ─────────────────────────────────────────────────────
# Caminho do ficheiro SQLite (por omissão data/mozfuthouse.db)
#MZF_DB_FILE=data/mozfuthouse.db

# ── Email (recuperação de password) ───────────────────────────────────
# Sem MAIL_HOST, o código de recuperação é mostrado no ecrã (modo demo).
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_SECURE=false
#MAIL_USER=no-reply@example.com
#MAIL_PASS=sua-password
#MAIL_FROM=MozFutHouse <no-reply@example.com>